# herdr writes its bundled defaults and runtime state here; track only my own files.
/*
!/.gitignore
!/keys.json
!/settings.json

!/themes/
/themes/*
!/themes/tokyonight-moon.json

!/layouts/
/layouts/*
!/layouts/jonas.json

!/mods/
/mods/*
!/mods/claude-usage/
!/mods/my-agents/
!/mods/my-spaces/
!/mods/my-tabs/
!/mods/task-handover/
!/mods/tasks/
