#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["anthropic"]
# ///
"""daily-wallpaper: once a day, Claude picks an image set for the Cinnamon Dynamic Wallpaper
extension, based on the Karlsruhe weather forecast, the season and recent picks.

  daily-wallpaper              pick today's set (does nothing if today's set is already picked)
  daily-wallpaper --force      pick again, avoiding today's set
  daily-wallpaper --random     pick at random, without Claude
  daily-wallpaper --dry-run    show the prompt and Claude's choice, change nothing
  daily-wallpaper --log        show recent picks

The chosen set's images are linked into ~/.local/share/daily-wallpaper/current/ as 0.jpg..9.jpg.
The extension shows that folder and keeps switching images by time of day.
"""

import argparse
import datetime as dt
import json
import os
import random
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

import anthropic

MODEL = "claude-sonnet-5-5"
# USD per million tokens (input, output), for the cost line in the log
PRICE = (2.00, 10.00)
LAT, LON = 49.0069, 8.4037  # Karlsruhe
HISTORY_SHOWN = 14

HOME = Path.home()
CATALOG = HOME / ".config/daily-wallpaper/sets.json"
CUSTOM_SETS = HOME / ".local/share/daily-wallpaper/sets"
CURRENT = HOME / ".local/share/daily-wallpaper/current"
HISTORY = HOME / ".local/state/daily-wallpaper/history.jsonl"
# Optional, not in git: ANTHROPIC_API_KEY=sk-ant-... (otherwise the usual SDK credential lookup)
ENV_FILE = HOME / ".config/daily-wallpaper/env"
EXT_UUID = "cinnamon-dynamic-wallpaper@TobiZog"
EXT_DIR = HOME / ".local/share/cinnamon/extensions" / EXT_UUID
EXT_PREFS = HOME / ".config/cinnamon/spices" / EXT_UUID / f"{EXT_UUID}.json"
IMAGE_SUFFIXES = (".jpg", ".jpeg", ".png", ".bmp", ".svg")

# WMO weather codes as used by Open-Meteo
WEATHER_CODES = {
    0: "clear sky", 1: "mainly clear", 2: "partly cloudy", 3: "overcast",
    45: "fog", 48: "freezing fog",
    51: "light drizzle", 53: "drizzle", 55: "dense drizzle", 56: "freezing drizzle", 57: "freezing drizzle",
    61: "light rain", 63: "rain", 65: "heavy rain", 66: "freezing rain", 67: "freezing rain",
    71: "light snow", 73: "snow", 75: "heavy snow", 77: "snow grains",
    80: "light showers", 81: "showers", 82: "violent showers", 85: "snow showers", 86: "heavy snow showers",
    95: "thunderstorm", 96: "thunderstorm with hail", 99: "thunderstorm with heavy hail",
}

SYSTEM_PROMPT = """\
You pick the desktop wallpaper for the day for someone in Karlsruhe, Germany. Each wallpaper is \
an image set that changes with the time of day (dawn, day, dusk, night), so you are choosing a \
scene and mood for the whole day, not a single image.

How to choose:
- Weather is a hint, not a rule. On a pleasant day, a scene that matches it is nice. On a long \
grey or rainy stretch, something warm, sunny or far away can be the better gift.
- Consider the season and the weekday (a calm, minimal set suits a busy Monday; something more \
adventurous suits a weekend).
- Avoid repeating sets from the last few days; variety matters more the more recently a set was \
used.

Reply with the set name and one short, friendly sentence (max 20 words) on why it fits today. \
Don't restate the weather numbers."""


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


def load_sets() -> list[dict]:
    builtin = EXT_DIR / "5.4/res/images/included_image_sets"
    sets = []
    for entry in json.loads(CATALOG.read_text())["sets"]:
        path = Path(os.path.expanduser(entry["path"].replace("{builtin}", str(builtin))))
        sets.append({**entry, "path": path})
    if CUSTOM_SETS.is_dir():
        known = {s["name"] for s in sets}
        for d in sorted(CUSTOM_SETS.iterdir()):
            if d.is_dir() and d.name not in known:
                desc = d / "description.txt"
                sets.append({
                    "name": d.name,
                    "path": d,
                    "description": desc.read_text().strip() if desc.exists() else "(no description)",
                })
    usable = [s for s in sets if images_in(s["path"])]
    for s in sets:
        if s not in usable:
            log(f"skipping set {s['name']}: no images in {s['path']}")
    return usable


def images_in(folder: Path) -> list[Path]:
    if not folder.is_dir():
        return []
    return sorted(p for p in folder.iterdir() if p.suffix.lower() in IMAGE_SUFFIXES)


def load_history() -> list[dict]:
    if not HISTORY.exists():
        return []
    return [json.loads(line) for line in HISTORY.read_text().splitlines() if line.strip()]


def fetch_weather() -> str | None:
    url = (
        "https://api.open-meteo.com/v1/forecast"
        f"?latitude={LAT}&longitude={LON}&timezone=Europe%2FBerlin&forecast_days=1"
        "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,"
        "precipitation_probability_max,sunshine_duration,wind_speed_10m_max"
    )
    # The timer can fire right after boot or resume, before the network is up
    for attempt in range(6):
        try:
            with urllib.request.urlopen(url, timeout=15) as resp:
                day = {k: v[0] for k, v in json.load(resp)["daily"].items()}
            break
        except OSError as e:
            if attempt == 5:
                log(f"weather unavailable: {e}")
                return None
            time.sleep(20)
    return (
        f"{WEATHER_CODES.get(day['weather_code'], 'unknown')}, "
        f"{day['temperature_2m_min']:.0f}–{day['temperature_2m_max']:.0f} °C, "
        f"{day['precipitation_probability_max']}% chance of rain ({day['precipitation_sum']} mm), "
        f"{day['sunshine_duration'] / 3600:.1f} h of sun, wind up to {day['wind_speed_10m_max']:.0f} km/h"
    )


def season(d: dt.date) -> str:
    return ["winter", "spring", "summer", "autumn"][(d.month % 12) // 3]


def build_prompt(sets: list[dict], history: list[dict], weather: str | None, today: dt.date) -> str:
    recent = history[-HISTORY_SHOWN:]
    lines = [
        f"Today: {today:%A, %d %B %Y} ({season(today)})",
        f"Forecast for Karlsruhe: {weather or 'unavailable'}",
        "",
        "Recent picks (oldest first):" if recent else "Recent picks: none yet",
        *(f"- {h['date']}: {h['set']}" for h in recent),
        "",
        "Available sets:",
        *(f"- {s['name']}: {s['description']}" for s in sets),
    ]
    return "\n".join(lines)


def load_env_file() -> None:
    if not ENV_FILE.exists():
        return
    for line in ENV_FILE.read_text().splitlines():
        key, sep, value = line.strip().partition("=")
        if sep and not key.startswith("#"):
            os.environ.setdefault(key.strip(), value.strip().strip("'\""))


def ask_claude(sets: list[dict], prompt: str) -> tuple[str, str, dict]:
    load_env_file()
    client = anthropic.Anthropic()
    response = client.beta.messages.create(
        model=MODEL,
        max_tokens=4000,
        system=SYSTEM_PROMPT,
        messages=[{"role": "user", "content": prompt}],
        output_config={
            "effort": "low",
            "format": {
                "type": "json_schema",
                "schema": {
                    "type": "object",
                    "properties": {
                        "set": {"type": "string", "enum": [s["name"] for s in sets]},
                        "reason": {"type": "string"},
                    },
                    "required": ["set", "reason"],
                    "additionalProperties": False,
                },
            },
        },
        # On a safety decline, the API retries on Anthropic's recommended fallback model
        betas=["server-side-fallback-2026-07-01"],
        fallbacks="default",
    )
    if response.stop_reason != "end_turn":
        raise RuntimeError(f"unexpected stop_reason {response.stop_reason}")
    text = next(b.text for b in response.content if b.type == "text")
    choice = json.loads(text)
    usage = {
        "model": response.model,
        "input_tokens": response.usage.input_tokens,
        "output_tokens": response.usage.output_tokens,
    }
    usage["cost_usd"] = round(
        (usage["input_tokens"] * PRICE[0] + usage["output_tokens"] * PRICE[1]) / 1e6, 5
    )
    return choice["set"], choice["reason"], usage


def apply_set(folder: Path) -> None:
    images = images_in(folder)
    # The extension expects one image per period (10). Spread other counts over the periods.
    picks = [images[round(i * (len(images) - 1) / 9)] for i in range(10)]
    CURRENT.mkdir(parents=True, exist_ok=True)
    for i, src in enumerate(picks):
        link = CURRENT / f"{i}.jpg"  # Cinnamon detects the format from the content, not the name
        tmp = CURRENT / f".{i}.jpg.tmp"
        tmp.unlink(missing_ok=True)
        tmp.symlink_to(src)
        tmp.replace(link)
    point_extension_at_current()
    refresh_background()


def point_extension_at_current() -> None:
    prefs = json.loads(EXT_PREFS.read_text())
    wanted = {"image_source": "source_folder", "source_folder": f"{CURRENT}/"}
    wanted |= {f"period_{i}_image": f"{i}.jpg" for i in range(10)}
    if all(prefs.get(k, {}).get("value") == v for k, v in wanted.items()):
        return
    for k, v in wanted.items():
        prefs.setdefault(k, {"type": "generic"})["value"] = v
    # Same format as the extension's own preference writer
    EXT_PREFS.write_text(json.dumps(prefs, separators=(",", ":"), indent=4))
    log(f"pointed the extension at {CURRENT}")


def refresh_background() -> None:
    """The extension sets picture-uri to current/N.jpg every minute. That value doesn't change when
    only the link target does, so Cinnamon wouldn't reload. Point picture-uri at the link's target
    for now; the extension switches back to the link within a minute."""
    key = ["org.cinnamon.desktop.background", "picture-uri"]
    try:
        uri = subprocess.run(["gsettings", "get", *key], capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError) as e:
        log(f"could not read the background setting: {e}")
        return
    path = uri.stdout.strip().strip("'").removeprefix("file://")
    if Path(path).parent != CURRENT:
        return  # the extension picks up the new folder on its next run
    subprocess.run(["gsettings", "set", *key, f"file://{Path(path).resolve()}"], check=False)


def notify(title: str, body: str) -> None:
    try:
        subprocess.run(["notify-send", "-a", "Daily wallpaper", title, body], check=False)
    except OSError:
        pass


def show_log(history: list[dict]) -> None:
    for h in history[-30:]:
        cost = f"${h['usage']['cost_usd']:.4f}" if h.get("usage") else "random"
        print(f"{h['date']}  {h['set']:<10} {cost:>8}  {h['reason']}")
    costs = [h["usage"]["cost_usd"] for h in history if h.get("usage")]
    if costs:
        print(f"\n{len(costs)} Claude picks, ${sum(costs):.3f} total, ${sum(costs) / len(costs):.4f} each")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--force", action="store_true", help="pick again even if today's set is already picked")
    parser.add_argument("--random", action="store_true", help="pick at random, without Claude")
    parser.add_argument("--dry-run", action="store_true", help="show prompt and choice, change nothing")
    parser.add_argument("--log", action="store_true", help="show recent picks")
    args = parser.parse_args()

    history = load_history()
    if args.log:
        show_log(history)
        return

    today = dt.date.today()
    todays = [h["set"] for h in history if h["date"] == today.isoformat()]
    if todays and not (args.force or args.dry_run or args.random):
        log(f"today's set is already {todays[-1]} (use --force to pick again)")
        return

    sets = load_sets()
    if args.force:
        sets = [s for s in sets if s["name"] not in todays] or sets

    weather = None if args.random else fetch_weather()
    prompt = build_prompt(sets, history, weather, today)
    if args.dry_run:
        print(SYSTEM_PROMPT, prompt, sep="\n\n---\n\n", end="\n\n---\n\n")

    usage = None
    if args.random:
        recent = {h["set"] for h in history[-5:]}
        name = random.choice([s for s in sets if s["name"] not in recent] or sets)["name"]
        reason = "Random pick."
    else:
        try:
            name, reason, usage = ask_claude(sets, prompt)
        except (anthropic.AnthropicError, RuntimeError, StopIteration, json.JSONDecodeError) as e:
            log(f"Claude unavailable ({e}), picking at random")
            recent = {h["set"] for h in history[-5:]}
            name = random.choice([s for s in sets if s["name"] not in recent] or sets)["name"]
            reason = "Random pick (Claude was unavailable)."

    print(f"{name}: {reason}")
    if usage:
        print(f"{usage['input_tokens']} in / {usage['output_tokens']} out tokens, ${usage['cost_usd']:.4f}")
    if args.dry_run:
        return

    apply_set(next(s["path"] for s in sets if s["name"] == name))
    HISTORY.parent.mkdir(parents=True, exist_ok=True)
    with HISTORY.open("a") as f:
        entry = {"date": today.isoformat(), "set": name, "reason": reason, "weather": weather, "usage": usage}
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    notify(f"Wallpaper: {name}", reason)


if __name__ == "__main__":
    main()
